{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBackupServiceToAssume",
      "Effect": "Allow",
      "Principal": { "Service": "backup.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "123456789012" }
      }
    }
  ]
}
